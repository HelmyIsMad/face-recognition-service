  "components": {
    "schemas": {
      "BlockRequest": {
        "properties": {
          "face_id": {
            "type": "string",
            "title": "Face Id"
          },
          "name": {
            "type": "string",
            "title": "Name",
            "default": ""
          },
          "reason": {
            "type": "string",
            "title": "Reason",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "face_id"
        ],
        "title": "BlockRequest"
      },
      "Body_enroll_enroll_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File",
            "description": "Image file with a single face"
          },
          "list": {
            "type": "string",
            "enum": [
              "trusted",
              "blocked"
            ],
            "title": "List",
            "description": "Target table"
          },
          "name": {
            "type": "string",
            "title": "Name",
            "description": "Person label",
            "default": ""
          },
          "reason": {
            "type": "string",
            "title": "Reason",
            "description": "Block reason (blocked only)",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "file",
          "list"
        ],
        "title": "Body_enroll_enroll_post"
      },
      "Body_verify_verify_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File",
            "description": "Image file (jpg/png/webp/...)"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_verify_verify_post"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "TrustRequest": {
        "properties": {
          "face_id": {
            "type": "string",
            "title": "Face Id"
          },
          "name": {
            "type": "string",
            "title": "Name",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "face_id"
        ],
        "title": "TrustRequest"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}